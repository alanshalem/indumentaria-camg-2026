# ---------------------------------------------------------------------------
#  Servidor (Vercel → Project Settings → Environment Variables)
#  NINGUNA de estas lleva prefijo VITE_: jamás deben llegar al bundle del browser.
# ---------------------------------------------------------------------------

# Supabase → Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase → Settings → API Keys → la key "secret" (sb_secret_...).
# Es la que antes se llamaba service_role. Sortea RLS: nunca exponerla.
# NO uses la "publishable" (sb_publishable_...): con esa fallan todos los endpoints.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Clave del panel administrativo (/login).
ADMIN_PASSWORD=una-clave-larga-y-unica

# Secreto para firmar los tokens de sesión admin (HS256).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ⚠️ Este archivo SÍ va a git. El valor real va en .env.local, nunca acá.
ADMIN_TOKEN_SECRET=

# Opcional: bucket de Supabase Storage para las fotos que suba el admin.
SUPABASE_IMAGE_BUCKET=product-images

# ---------------------------------------------------------------------------
#  Sólo para los scripts de base (npm run db:setup). NO hace falta en Vercel.
#  Supabase → botón "Connect" → pestaña "Direct · Connection string"
#  → adentro elegí "Session pooler" → copiá el URI y reemplazá [YOUR-PASSWORD]
#  por la contraseña de la BASE (no una API key).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
#  Cliente (opcional)
# ---------------------------------------------------------------------------
# Sólo si el frontend corre en un origen distinto al de la API.
# VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
#  Mails transaccionales (Resend). TODO opcional: sin RESEND_API_KEY la app
#  funciona igual, los envíos quedan registrados como "skipped" y ningún pedido
#  falla por esto.
# ---------------------------------------------------------------------------

# resend.com → API Keys. Empieza con re_
RESEND_API_KEY=

# Remitente. El dominio tiene que estar VERIFICADO en Resend.
# La casilla NO necesita existir: es sólo el remitente, las respuestas van a
# EMAIL_REPLY_TO. Sin dominio verificado, el default onboarding@resend.dev
# entrega únicamente a la casilla dueña de la cuenta de Resend.
EMAIL_FROM=CAMG <pedidos@clubatleticomontegrande.com.ar>

# Opcional. Sin esto, las respuestas van al From (que no tiene buzón) y rebotan:
# es lo que queremos, los mails son de sólo ida y el pie remite al WhatsApp.
# Si algún día se quiere recibir respuestas, poner acá una casilla real.
# EMAIL_REPLY_TO=

# Base absoluta para el logo de los mails: tiene que apuntar a donde vive el
# SITIO, que puede ser un dominio distinto al del remitente. Si el sitio sigue
# en vercel.app, esto se queda en vercel.app aunque los mails salgan desde
# clubatleticomontegrande.com.ar.
PUBLIC_SITE_URL=https://indumentaria-camg-2026.vercel.app

# Los datos del club (alias de pago, dirección, horarios, teléfono) NO son
# variables de entorno: viven en shared/domain/club.ts. No son secretos y como
# env vars fallaban en silencio si faltaba alguna.
